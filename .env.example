# Firecrawl API Key
# Get yours at https://firecrawl.dev
FIRECRAWL_API_KEY=fc-your-api-key-here

# TinyFish API Key (optional alternate scraper)
# Get yours at https://agent.tinyfish.ai/sign-up
TINYFISH_API_KEY=your-tinyfish-api-key-here

# OpenAI API Key
# Get yours at https://platform.openai.com
OPENAI_API_KEY=sk-your-api-key-here

# Enable unlimited mode (optional)
# When true, removes all limits on rows, columns, and file size
# Automatically enabled in development mode
SUPER_ENRICH_UNLIMITED=true

# Node environment (development/production)
NODE_ENV=development

# --- Auth + Database (V1.0 foundation) ---
# Neon Postgres connection string (pooled)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Session signing secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me
# App base URL
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth (optional; enables "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=